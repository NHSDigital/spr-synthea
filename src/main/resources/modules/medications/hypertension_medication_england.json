{
  "name": "Hypertension Medication (England, NICE NG136)",
  "remarks": [
    "Antihypertensive drug treatment following NICE guideline NG136 (Hypertension in adults: diagnosis and management), https://www.nice.org.uk/guidance/ng136.",
    "Called from the hypertension module when the person's country attribute is GB. Mirrors the contract of medications/hypertension_medication: sets hypertension_severe on first call and increments hypertension_medication_step on every call.",
    "Ramipril is used as the ACE inhibitor and candesartan as the ARB, as the most commonly prescribed agents in England. Indapamide is the thiazide-like diuretic recommended by NICE."
  ],
  "states": {
    "Initial": {
      "type": "Initial",
      "conditional_transition": [
        {
          "transition": "Initialize_Step",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "hypertension_medication_step",
            "operator": "is nil"
          }
        },
        {
          "transition": "Increase_Step"
        }
      ]
    },
    "Initialize_Step": {
      "type": "SetAttribute",
      "attribute": "hypertension_medication_step",
      "value": 0,
      "conditional_transition": [
        {
          "transition": "High_BP",
          "condition": {
            "condition_type": "Vital Sign",
            "vital_sign": "Systolic Blood Pressure",
            "operator": "<",
            "value": 160
          }
        },
        {
          "transition": "Very_High_BP"
        }
      ]
    },
    "High_BP": {
      "type": "SetAttribute",
      "attribute": "hypertension_severe",
      "value": false,
      "direct_transition": "Increase_Step"
    },
    "Very_High_BP": {
      "type": "SetAttribute",
      "attribute": "hypertension_severe",
      "value": true,
      "direct_transition": "Increase_Step"
    },
    "Increase_Step": {
      "type": "Counter",
      "attribute": "hypertension_medication_step",
      "action": "increment",
      "direct_transition": "Check_Step"
    },
    "Check_Step": {
      "type": "Simple",
      "conditional_transition": [
        {
          "transition": "Step_1",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "hypertension_medication_step",
            "operator": "==",
            "value": 1
          }
        },
        {
          "transition": "Step_2",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "hypertension_medication_step",
            "operator": "==",
            "value": 2
          }
        },
        {
          "transition": "Step_3",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "hypertension_medication_step",
            "operator": "==",
            "value": 3
          }
        },
        {
          "transition": "Step_4",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "hypertension_medication_step",
            "operator": "==",
            "value": 4
          }
        },
        {
          "transition": "Refer_To_Specialist"
        }
      ],
      "remarks": [
        "NICE NG136 treatment steps. Step 1 is monotherapy, step 2 dual therapy, step 3 triple therapy (ACEi/ARB + CCB + thiazide-like diuretic), step 4 resistant hypertension."
      ]
    },
    "Step_1": {
      "type": "Simple",
      "conditional_transition": [
        {
          "transition": "Labetalol",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "pregnant",
            "operator": "==",
            "value": true
          }
        },
        {
          "transition": "ACEi_or_ARB_1",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "diabetes",
            "operator": "==",
            "value": true
          }
        },
        {
          "transition": "Amlodipine_1",
          "condition": {
            "condition_type": "Race",
            "race": "Black"
          }
        },
        {
          "transition": "Amlodipine_1",
          "condition": {
            "condition_type": "Age",
            "operator": ">=",
            "quantity": 55,
            "unit": "years"
          }
        },
        {
          "transition": "ACEi_or_ARB_1"
        }
      ],
      "remarks": [
        "Pregnancy: labetalol (NICE NG133). Type 2 diabetes or age < 55 and not Black African/African-Caribbean: ACEi or ARB. Otherwise: CCB."
      ]
    },
